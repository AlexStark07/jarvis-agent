# JARVIS Environment Configuration

# Application settings
JARVIS_ENV=development
LOG_LEVEL=INFO

# Database configuration
# Leave empty to use default local SQLite db at data/jarvis.db
DATABASE_URL=

# Model Providers
# LLM_PROVIDER can be 'mock', 'openai', 'anthropic', etc.
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# External Integrations
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
N8N_WEBHOOK_URL=your_n8n_url_here

# Worker Configuration
# Set to 'false' if running tests locally without a Docker daemon
DOCKER_ENABLED=true
WORKER_TIMEOUT_SECONDS=300
